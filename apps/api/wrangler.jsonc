{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "quant-clarity-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false,
      "persist": false,
      "destinations": [],
    },
    "traces": {
      "enabled": false,
      "persist": false,
      "destinations": [],
    },
  },
  "ratelimits": [
    {
      "name": "READ_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "ROTATION_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 600, "period": 60 },
    },
  ],
}
