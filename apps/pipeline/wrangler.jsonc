{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "quant-clarity-pipeline-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false,
      "persist": false,
      "destinations": [],
    },
    "traces": {
      "enabled": false,
      "persist": false,
      "destinations": [],
    },
  },
}
