---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  currentPath?: string;
}

const { title, description, currentPath = Astro.url.pathname } = Astro.props;
const canonicalUrl = Astro.site ? new URL(currentPath, Astro.site) : undefined;
const publicationState = Astro.locals.publicationState;
const publishedAt =
  publicationState.kind === "published"
    ? new Intl.DateTimeFormat("en", {
        day: "numeric",
        hour: "numeric",
        minute: "2-digit",
        month: "short",
        timeZone: "UTC",
        timeZoneName: "short",
        year: "numeric",
      }).format(new Date(publicationState.metadata.generated_at))
    : null;
const navigation = [
  { href: "/", label: "Search" },
  { href: "/models", label: "Models" },
  { href: "/providers", label: "Providers" },
  { href: "/methodology", label: "Methodology" },
  { href: "/api", label: "API" },
  { href: "/privacy", label: "Privacy" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="QuantClarity home">
          <span aria-hidden="true" class="brand-mark">QC</span>
          <span>QuantClarity</span>
        </a>
        <nav aria-label="Primary navigation">
          <ul class="nav-list">
            {
              navigation.map((item) => (
                <li>
                  <a
                    aria-current={
                      currentPath === item.href ||
                      (item.href !== "/" &&
                        currentPath.startsWith(`${item.href}/`))
                        ? "page"
                        : undefined
                    }
                    href={item.href}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <div class="publication-status" role="status">
      <div class="shell status-inner">
        <span class="status-label">Dataset status</span>
        <span>
          {
            publicationState.kind === "published"
              ? `Publication ${publicationState.metadata.publication_id}`
              : publicationState.kind === "not_published"
                ? "No public data publication yet"
                : "Publication status temporarily unavailable"
          }
        </span>
        <span class="status-separator" aria-hidden="true">•</span>
        <span>
          Data refreshed: {
            publicationState.kind === "published" && publishedAt !== null ? (
              <strong>
                <time datetime={publicationState.metadata.generated_at}>
                  {publishedAt}
                </time>
              </strong>
            ) : (
              <strong>
                {publicationState.kind === "not_published"
                  ? "Not yet published"
                  : "Unavailable"}
              </strong>
            )
          }
        </span>
      </div>
    </div>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <p class="footer-brand">QuantClarity</p>
          <p class="quiet">
            Free, factual comparison of public inference-provider data. No
            rankings, tracking, or visitor profiles.
          </p>
        </div>
        <nav aria-label="Legal navigation">
          <ul class="footer-links">
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/terms">Terms</a></li>
            <li><a href="/methodology">Methodology</a></li>
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>
