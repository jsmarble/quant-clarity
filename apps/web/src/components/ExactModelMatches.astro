---
import {
  exactModelMatchLabel,
  exactModelSearchPageHref,
} from "../lib/exact-model-search-page.js";
import type { ExactModelSearchCollection } from "../lib/exact-model-search.js";

import FactValue from "./FactValue.astro";

interface Props {
  collection: ExactModelSearchCollection;
  query: string;
}

const { collection, query } = Astro.props;
const nextHref =
  collection.page.next_cursor === null
    ? null
    : exactModelSearchPageHref(
        query,
        collection.page.next_cursor,
        collection.meta.publication_id,
      );
const formatTimestamp = (value: string): string =>
  new Intl.DateTimeFormat("en", {
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
    month: "short",
    timeZone: "UTC",
    timeZoneName: "short",
    year: "numeric",
  }).format(new Date(value));
const formatParameter = (value: {
  approximation: string;
  normalized_decimal: string | null;
  raw_value: string;
}): string =>
  `${value.raw_value}; normalized: ${value.normalized_decimal ?? "unknown"}; approximation: ${value.approximation}`;
---

<section class="exact-matches" aria-labelledby="exact-model-matches-title">
  <p class="quiet results-publication">
    Results publication: <code>{collection.meta.publication_id}</code>
  </p>
  {
    collection.data.length === 0 ? (
      <div class="empty-state">
        <p class="eyebrow">Exact discovery</p>
        <h2 id="exact-model-matches-title">No exact Model matches</h2>
        <p class="result-summary" role="status">
          No Model target matched <strong>“{query}”</strong> in this
          publication’s exact name or provider model ID indexes.
        </p>
        <a class="button-link" href="/models">
          Clear search
        </a>
      </div>
    ) : (
      <>
        <div class="results-heading">
          <div>
            <p class="eyebrow">Exact discovery</p>
            <h2 id="exact-model-matches-title">Exact Model matches</h2>
          </div>
          <p class="result-summary" role="status">
            {collection.data.length} exact{" "}
            {collection.data.length === 1 ? "Model match" : "Model matches"} for{" "}
            <strong>“{query}”</strong>
          </p>
        </div>
        <ol class="exact-match-list" aria-label="Exact Model matches">
          {collection.data.map((result, index) => {
            const model = result.model;
            const displayName =
              model.display_name.state === "known"
                ? model.display_name.value
                : "Model name unknown";
            const titleId = `exact-model-match-${String(index)}`;
            const matchLabel = exactModelMatchLabel(result.match_kind);
            return (
              <li>
                <article class="exact-match" aria-labelledby={titleId}>
                  <p class="eyebrow">Canonical Model</p>
                  <h3 id={titleId}>
                    <a href={`/models/${model.model_id}`}>{displayName}</a>
                  </h3>
                  <dl class="match-facts">
                    <div>
                      <dt>Match</dt>
                      <dd>{matchLabel}</dd>
                    </div>
                    <div>
                      <dt>QuantClarity Model ID</dt>
                      <dd>
                        <code>{model.model_id}</code>
                      </dd>
                    </div>
                  </dl>
                  <dl class="fact-grid model-card-facts">
                    <FactValue label="Display name" fact={model.display_name} />
                    <FactValue label="Publisher" fact={model.publisher} />
                    <FactValue
                      label="Total parameters"
                      fact={model.total_parameters}
                      displayValue={
                        model.total_parameters.state === "known"
                          ? formatParameter(model.total_parameters.value)
                          : undefined
                      }
                    />
                    <FactValue
                      label="Active parameters"
                      fact={model.active_parameters}
                      displayValue={
                        model.active_parameters.state === "known"
                          ? formatParameter(model.active_parameters.value)
                          : undefined
                      }
                    />
                    <FactValue
                      label="Source checkpoint weight format"
                      fact={model.source_weight_format}
                    />
                    <FactValue
                      label="Source-provided quantization"
                      fact={model.source_quantization}
                    />
                    <div class="fact-row">
                      <dt>Cataloged provider count</dt>
                      <dd>
                        <div class="fact-value">
                          {model.cataloged_provider_count.value}
                        </div>
                        <div class="fact-meta">
                          <span>
                            Observed:{" "}
                            <time
                              datetime={
                                model.cataloged_provider_count.observed_at
                              }
                            >
                              {formatTimestamp(
                                model.cataloged_provider_count.observed_at,
                              )}
                            </time>
                          </span>
                          <span>
                            Derivation:{" "}
                            <code>
                              {
                                model.cataloged_provider_count
                                  .derivation_version
                              }
                            </code>
                          </span>
                        </div>
                      </dd>
                    </div>
                    <FactValue
                      label="Last Model-data refresh"
                      fact={model.last_model_data_refresh}
                      displayValue={
                        model.last_model_data_refresh.state === "known"
                          ? formatTimestamp(model.last_model_data_refresh.value)
                          : undefined
                      }
                    />
                  </dl>
                </article>
              </li>
            );
          })}
        </ol>
        <nav class="pagination" aria-label="Exact Model match pages">
          <a class="button-link secondary" href="/models">
            Clear search
          </a>
          {nextHref !== null && (
            <a class="button-link" href={nextHref} rel="next">
              Next exact matches
            </a>
          )}
        </nav>
      </>
    )
  }
</section>
