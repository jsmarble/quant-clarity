---
interface Props {
  value?: string;
  compact?: boolean;
}

const { value = "", compact = false } = Astro.props;
---

<form
  class:list={["search-form", { compact }]}
  action="/models"
  method="get"
  role="search"
>
  <label for="model-search"
    >Search exact Model names or provider model IDs</label
  >
  <div class="search-row">
    <input
      id="model-search"
      type="search"
      name="q"
      value={value}
      maxlength="200"
      autocomplete="off"
      enterkeyhint="search"
      placeholder="Enter an exact Model name or provider model ID"
    />
    <button type="submit">Search</button>
  </div>
  <p class="form-hint">
    This slice returns exact Model targets only. QuantClarity does not retain
    search terms or send them to analytics.
  </p>
</form>
