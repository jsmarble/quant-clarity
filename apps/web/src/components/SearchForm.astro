---
interface Props {
  value?: string;
  compact?: boolean;
}

const { value = "", compact = false } = Astro.props;
---

<form
  class:list={["search-form", { compact }]}
  action="/models"
  method="get"
  role="search"
>
  <label for="model-search">Search models and variants</label>
  <div class="search-row">
    <input
      id="model-search"
      type="search"
      name="q"
      value={value}
      maxlength="160"
      autocomplete="off"
      enterkeyhint="search"
      placeholder="Try a model name, alias, publisher, provider, or provider model ID"
    />
    <button type="submit">Search</button>
  </div>
  <p class="form-hint">
    Search terms remain in this request only. They are not stored or sent to
    analytics.
  </p>
</form>
