---
interface Props {
  subject: string;
}

const { subject } = Astro.props;
---

<section class="empty-state" aria-labelledby="empty-title">
  <p class="eyebrow">Publication pending</p>
  <h2 id="empty-title">No {subject} are published yet</h2>
  <p>
    QuantClarity will show facts only after their evidence, scope, and
    observation time pass the publication gates. Unknown facts will stay
    explicitly unknown.
  </p>
  <a class="text-link" href="/methodology">Read the publication methodology</a>
</section>
