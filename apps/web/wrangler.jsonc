{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "quant-clarity-web-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_do_not_populate_process_env",
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true,
  },
  "vars": {
    "DEPLOYMENT_ENV": "local",
  },
  "services": [
    {
      "binding": "API",
      "service": "quant-clarity-api-local",
    },
  ],
  "ratelimits": [
    {
      "name": "READ_LIMITER",
      "namespace_id": "3001",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "ROTATION_LIMITER",
      "namespace_id": "3002",
      "simple": { "limit": 600, "period": 60 },
    },
  ],
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false,
      "persist": false,
      "destinations": [],
    },
    "traces": {
      "enabled": false,
      "persist": false,
      "destinations": [],
    },
  },
}
