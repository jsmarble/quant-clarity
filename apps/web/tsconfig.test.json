{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@quant-clarity/api-core": ["../../packages/api-core/src/index.ts"],
      "@quant-clarity/contracts": ["../../packages/contracts/src/index.ts"],
      "@quant-clarity/domain/source-address": [
        "../../packages/domain/src/source-address.ts"
      ]
    },
    "skipLibCheck": true,
    "types": ["./worker-configuration.d.ts", "vitest/globals"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/lib/**/*.ts",
    "worker-configuration.d.ts"
  ],
  "references": [
    { "path": "../../packages/api-core/tsconfig.build.json" },
    { "path": "../../packages/contracts" },
    { "path": "../../packages/domain" }
  ]
}
