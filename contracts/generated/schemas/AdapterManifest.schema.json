{
  "$id": "AdapterManifest",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "contract_version",
    "provider_id",
    "adapter_version",
    "enabled_environments",
    "source_policy_version",
    "sources",
    "credential_handles",
    "roster_path",
    "roster_version",
    "roster_hash",
    "parser_version",
    "extraction_policy_version",
    "budgets",
    "compliance_review"
  ],
  "properties": {
    "contract_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "provider_id": {
      "pattern": "^prv_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "adapter_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\+sha256\\.[0-9a-f]{64}$",
      "type": "string"
    },
    "enabled_environments": {
      "uniqueItems": true,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "const": "local",
            "type": "string"
          },
          {
            "const": "test",
            "type": "string"
          },
          {
            "const": "preview",
            "type": "string"
          },
          {
            "const": "production",
            "type": "string"
          }
        ]
      }
    },
    "source_policy_version": {
      "minLength": 1,
      "maxLength": 128,
      "type": "string"
    },
    "sources": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "scheme",
          "host",
          "path_template",
          "parameters",
          "method",
          "authentication_class",
          "allowed_headers",
          "source_type",
          "pagination",
          "content_types",
          "compressed_byte_limit",
          "uncompressed_byte_limit",
          "timeout_ms",
          "redirect_limit",
          "redirect_hosts",
          "provider_rate_limit",
          "crawl_purpose",
          "robots_policy",
          "content_signals_policy",
          "retention_permitted",
          "publication_permitted",
          "expected_precision_fields",
          "expected_price_fields",
          "browser_session_approved"
        ],
        "properties": {
          "source_id": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "scheme": {
            "const": "https",
            "type": "string"
          },
          "host": {
            "pattern": "^(?=.{1,253}$)(?:(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)\\.)+(?:[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?)$",
            "maxLength": 253,
            "type": "string"
          },
          "path_template": {
            "pattern": "^/",
            "maxLength": 1024,
            "type": "string"
          },
          "parameters": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "name",
                "location",
                "value_type",
                "required",
                "enum_values",
                "pattern",
                "maximum_length"
              ],
              "properties": {
                "name": {
                  "pattern": "^[a-z][a-z0-9_]{0,63}$",
                  "type": "string"
                },
                "location": {
                  "anyOf": [
                    {
                      "const": "path",
                      "type": "string"
                    },
                    {
                      "const": "query",
                      "type": "string"
                    }
                  ]
                },
                "value_type": {
                  "anyOf": [
                    {
                      "const": "string",
                      "type": "string"
                    },
                    {
                      "const": "integer",
                      "type": "string"
                    },
                    {
                      "const": "boolean",
                      "type": "string"
                    }
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "enum_values": {
                  "maxItems": 128,
                  "uniqueItems": true,
                  "type": "array",
                  "items": {
                    "minLength": 1,
                    "maxLength": 256,
                    "type": "string"
                  }
                },
                "pattern": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "maxLength": 256,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "maximum_length": {
                  "anyOf": [
                    {
                      "minimum": 1,
                      "maximum": 4096,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "method": {
            "const": "GET",
            "type": "string"
          },
          "authentication_class": {
            "anyOf": [
              {
                "const": "none",
                "type": "string"
              },
              {
                "const": "api_key",
                "type": "string"
              },
              {
                "const": "bearer",
                "type": "string"
              }
            ]
          },
          "allowed_headers": {
            "maxItems": 16,
            "uniqueItems": true,
            "type": "array",
            "items": {
              "maxLength": 64,
              "type": "string"
            }
          },
          "source_type": {
            "anyOf": [
              {
                "const": "provider_api",
                "type": "string"
              },
              {
                "const": "authenticated_catalog",
                "type": "string"
              },
              {
                "const": "public_static_page",
                "type": "string"
              },
              {
                "const": "public_rendered_page",
                "type": "string"
              },
              {
                "const": "publisher_checkpoint_repository",
                "type": "string"
              }
            ]
          },
          "pagination": {
            "minLength": 1,
            "maxLength": 128,
            "type": "string"
          },
          "content_types": {
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "type": "array",
            "items": {
              "maxLength": 128,
              "type": "string"
            }
          },
          "compressed_byte_limit": {
            "minimum": 1,
            "type": "integer"
          },
          "uncompressed_byte_limit": {
            "minimum": 1,
            "type": "integer"
          },
          "timeout_ms": {
            "minimum": 1,
            "type": "integer"
          },
          "redirect_limit": {
            "minimum": 0,
            "maximum": 5,
            "type": "integer"
          },
          "redirect_hosts": {
            "maxItems": 8,
            "uniqueItems": true,
            "type": "array",
            "items": {
              "pattern": "^(?=.{1,253}$)(?:(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)\\.)+(?:[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?)$",
              "maxLength": 253,
              "type": "string"
            }
          },
          "provider_rate_limit": {
            "minLength": 1,
            "maxLength": 128,
            "type": "string"
          },
          "crawl_purpose": {
            "minLength": 1,
            "maxLength": 128,
            "type": "string"
          },
          "robots_policy": {
            "minLength": 1,
            "maxLength": 128,
            "type": "string"
          },
          "content_signals_policy": {
            "minLength": 1,
            "maxLength": 128,
            "type": "string"
          },
          "retention_permitted": {
            "type": "boolean"
          },
          "publication_permitted": {
            "type": "boolean"
          },
          "expected_precision_fields": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "maxLength": 256,
              "type": "string"
            }
          },
          "expected_price_fields": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "maxLength": 256,
              "type": "string"
            }
          },
          "browser_session_approved": {
            "type": "boolean"
          }
        }
      }
    },
    "credential_handles": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "binding_name",
          "purpose"
        ],
        "properties": {
          "binding_name": {
            "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
            "type": "string"
          },
          "purpose": {
            "minLength": 1,
            "maxLength": 256,
            "type": "string"
          }
        }
      }
    },
    "roster_path": {
      "pattern": "^fixtures/",
      "maxLength": 512,
      "type": "string"
    },
    "roster_version": {
      "minLength": 1,
      "maxLength": 128,
      "type": "string"
    },
    "roster_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "parser_version": {
      "minLength": 1,
      "maxLength": 128,
      "type": "string"
    },
    "extraction_policy_version": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "budgets": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "requests_per_run",
        "pages_per_source",
        "bytes_per_run",
        "duration_ms",
        "retry_attempts",
        "browser_sessions",
        "ai_tokens",
        "items_per_run"
      ],
      "properties": {
        "requests_per_run": {
          "minimum": 1,
          "maximum": 10000,
          "type": "integer"
        },
        "pages_per_source": {
          "minimum": 1,
          "maximum": 10000,
          "type": "integer"
        },
        "bytes_per_run": {
          "minimum": 1,
          "maximum": 1000000000,
          "type": "integer"
        },
        "duration_ms": {
          "minimum": 1,
          "maximum": 43200000,
          "type": "integer"
        },
        "retry_attempts": {
          "minimum": 0,
          "maximum": 10,
          "type": "integer"
        },
        "browser_sessions": {
          "minimum": 0,
          "maximum": 1000,
          "type": "integer"
        },
        "ai_tokens": {
          "minimum": 0,
          "maximum": 10000000,
          "type": "integer"
        },
        "items_per_run": {
          "minimum": 1,
          "maximum": 100000,
          "type": "integer"
        }
      }
    },
    "compliance_review": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "reviewer_role",
        "reviewed_at",
        "terms_version",
        "robots_version",
        "content_signals_version",
        "access_permitted",
        "retention_permitted",
        "publication_permitted",
        "next_review_at"
      ],
      "properties": {
        "reviewer_role": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
          "type": "string"
        },
        "terms_version": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        "robots_version": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        "content_signals_version": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        "access_permitted": {
          "type": "boolean"
        },
        "retention_permitted": {
          "type": "boolean"
        },
        "publication_permitted": {
          "type": "boolean"
        },
        "next_review_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
          "type": "string"
        }
      }
    }
  }
}
