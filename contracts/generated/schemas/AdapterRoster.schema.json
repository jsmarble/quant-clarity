{
  "$id": "AdapterRoster",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "fixture_kind",
    "provider_id",
    "roster_version",
    "items"
  ],
  "properties": {
    "fixture_kind": {
      "anyOf": [
        {
          "const": "redacted_source",
          "type": "string"
        },
        {
          "const": "synthetic_non_publishable",
          "type": "string"
        }
      ]
    },
    "provider_id": {
      "pattern": "^prv_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "roster_version": {
      "minLength": 1,
      "maxLength": 128,
      "type": "string"
    },
    "items": {
      "minItems": 1,
      "maxItems": 100000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "roster_item_id",
          "provider_model_id",
          "tier_key",
          "endpoint_class",
          "material_region_key"
        ],
        "properties": {
          "roster_item_id": {
            "minLength": 1,
            "maxLength": 256,
            "type": "string"
          },
          "provider_model_id": {
            "minLength": 1,
            "maxLength": 512,
            "type": "string"
          },
          "tier_key": {
            "maxLength": 128,
            "type": "string"
          },
          "endpoint_class": {
            "minLength": 1,
            "maxLength": 128,
            "type": "string"
          },
          "material_region_key": {
            "maxLength": 128,
            "type": "string"
          }
        }
      }
    }
  }
}
