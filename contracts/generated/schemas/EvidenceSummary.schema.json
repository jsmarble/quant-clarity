{
  "$id": "EvidenceSummary",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "evidence_id",
    "subject_resource_id",
    "field",
    "value",
    "source_type",
    "source_owner",
    "source_url",
    "source_locator",
    "authenticated_only",
    "observed_at",
    "extraction_method",
    "extraction_version",
    "integrity_hash"
  ],
  "properties": {
    "evidence_id": {
      "pattern": "^evd_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "subject_resource_id": {
      "pattern": "^(org|fam|mdl|var|als|slg|chk|mck|edg|par|prv|off|scp|aff|src|obs|evd|clm|cfl|prc|cmp|pcs|occ|run|pvr|out|anm|qrn|pol|prn|pub)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "field": {
      "pattern": "^[a-z][a-z0-9_]{0,127}$",
      "type": "string"
    },
    "value": {
      "maxLength": 1000,
      "type": "string"
    },
    "source_type": {
      "minLength": 1,
      "maxLength": 64,
      "type": "string"
    },
    "source_owner": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "source_url": {
      "anyOf": [
        {
          "format": "uri",
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_locator": {
      "minLength": 1,
      "maxLength": 2048,
      "type": "string"
    },
    "authenticated_only": {
      "type": "boolean"
    },
    "observed_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "type": "string"
    },
    "extraction_method": {
      "minLength": 1,
      "maxLength": 64,
      "type": "string"
    },
    "extraction_version": {
      "minLength": 1,
      "maxLength": 128,
      "type": "string"
    },
    "integrity_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  }
}
