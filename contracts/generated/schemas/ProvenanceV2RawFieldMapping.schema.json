{
  "$id": "ProvenanceV2RawFieldMapping",
  "additionalProperties": false,
  "x-quantclarity-contract-status": "review_candidate",
  "type": "object",
  "required": [
    "authority_plan_id",
    "endpoint_id",
    "ordinal",
    "declaration_kind",
    "record_group",
    "record_selector",
    "raw_locator_kind",
    "raw_locator",
    "raw_label",
    "canonical_field_path",
    "value_source",
    "registered_value",
    "mapping_content_hash"
  ],
  "properties": {
    "authority_plan_id": {
      "pattern": "^vpa_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "endpoint_id": {
      "pattern": "^sep_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "ordinal": {
      "minimum": 0,
      "maximum": 4095,
      "type": "integer"
    },
    "declaration_kind": {
      "anyOf": [
        {
          "const": "applicability",
          "type": "string"
        },
        {
          "const": "price",
          "type": "string"
        },
        {
          "const": "precision",
          "type": "string"
        }
      ]
    },
    "record_group": {
      "anyOf": [
        {
          "const": "offering_applicability@1",
          "type": "string"
        },
        {
          "const": "price_tuple@1",
          "type": "string"
        },
        {
          "const": "precision_summary_tuple@1",
          "type": "string"
        },
        {
          "const": "precision_component_tuple@1",
          "type": "string"
        }
      ]
    },
    "record_selector": {
      "minLength": 1,
      "maxLength": 512,
      "type": "string"
    },
    "raw_locator_kind": {
      "anyOf": [
        {
          "const": "json_pointer_pattern@1",
          "type": "string"
        },
        {
          "const": "provider_label@1",
          "type": "string"
        },
        {
          "const": "registered_literal@1",
          "type": "string"
        }
      ]
    },
    "raw_locator": {
      "minLength": 1,
      "maxLength": 2048,
      "type": "string"
    },
    "raw_label": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "canonical_field_path": {
      "pattern": "^[a-z][a-z0-9_.]{0,127}$",
      "type": "string"
    },
    "value_source": {
      "anyOf": [
        {
          "const": "observed_value",
          "type": "string"
        },
        {
          "const": "field_identity_literal",
          "type": "string"
        },
        {
          "const": "registered_literal",
          "type": "string"
        },
        {
          "const": "observation_timestamp",
          "type": "string"
        }
      ]
    },
    "registered_value": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "mapping_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  }
}
