{
  "$id": "ApiMeta",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "resource",
    "publication_id",
    "schema_version",
    "sort",
    "filters"
  ],
  "properties": {
    "resource": {
      "const": "models",
      "type": "string"
    },
    "publication_id": {
      "pattern": "^pub_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "sort": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "const": "name",
            "type": "string"
          },
          {
            "const": "release_date",
            "type": "string"
          },
          {
            "const": "model_refresh",
            "type": "string"
          },
          {
            "const": "stable_id",
            "type": "string"
          }
        ]
      }
    },
    "filters": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "family": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "publisher": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "provider": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "normalized_source_precision": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "status": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "stale_offering": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "updated_since": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ]
        }
      }
    }
  }
}
