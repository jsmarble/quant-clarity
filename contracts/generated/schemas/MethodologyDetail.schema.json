{
  "$id": "MethodologyDetail",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "data",
    "meta"
  ],
  "properties": {
    "data": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "methodology_version",
        "methodology_effective_at",
        "methodology_url"
      ],
      "properties": {
        "methodology_version": {
          "minLength": 1,
          "maxLength": 64,
          "type": "string"
        },
        "methodology_effective_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
          "type": "string"
        },
        "methodology_url": {
          "format": "uri",
          "maxLength": 2048,
          "type": "string"
        }
      }
    },
    "meta": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "resource",
        "publication_id",
        "schema_version",
        "sort",
        "filters"
      ],
      "properties": {
        "resource": {
          "const": "methodologies",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^pub_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        },
        "sort": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "const": "version",
            "type": "string"
          }
        },
        "filters": {
          "additionalProperties": false,
          "type": "object",
          "properties": {}
        }
      }
    }
  }
}
