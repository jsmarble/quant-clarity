{
  "$id": "Methodology",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "methodology_version",
    "methodology_effective_at",
    "methodology_url"
  ],
  "properties": {
    "methodology_version": {
      "minLength": 1,
      "maxLength": 64,
      "type": "string"
    },
    "methodology_effective_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "type": "string"
    },
    "methodology_url": {
      "format": "uri",
      "maxLength": 2048,
      "type": "string"
    }
  }
}
