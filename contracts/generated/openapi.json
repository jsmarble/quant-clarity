{
  "openapi": "3.1.1",
  "info": {
    "title": "QuantClarity public API",
    "version": "1.0.0",
    "description": "Anonymous, read-only, neutral inference-provider facts. No visitor telemetry is retained.",
    "license": {
      "name": "MPL-2.0",
      "identifier": "MPL-2.0"
    }
  },
  "security": [],
  "servers": [
    {
      "url": "https://api.example.invalid/v1",
      "description": "Placeholder until the public domain is cleared"
    }
  ],
  "paths": {
    "/metadata": {
      "get": {
        "summary": "Get active dataset metadata",
        "operationId": "getMetadata",
        "responses": {
          "200": {
            "description": "Active dataset metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetMetadata"
                },
                "example": {
                  "publication_id": "pub_00000000-0000-4000-8000-000000000001",
                  "schema_version": "1.0.0",
                  "api_version": "1",
                  "methodology_version": "1.0.0",
                  "methodology_effective_at": "2026-08-01T00:00:00.000Z",
                  "methodology_url": "https://example.invalid/methodology/1.0.0",
                  "precision_vocabulary_version": "1.0.0",
                  "price_policy_version": "1.0.0",
                  "published_at": "2026-08-01T00:00:00.000Z",
                  "generated_at": "2026-08-01T00:00:00.000Z",
                  "next_refresh_window": {
                    "starts_at": "2026-08-03T05:00:00.000Z",
                    "ends_at": "2026-08-03T17:00:00.000Z"
                  },
                  "counts": {
                    "active_models": 0,
                    "active_offerings": 0,
                    "active_providers": 0
                  },
                  "degradation_notices": []
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "invalid_parameter",
                    "message": "The request contains an invalid parameter."
                  }
                }
              }
            }
          },
          "503": {
            "description": "No publication is ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DatasetMetadata": {
        "$id": "DatasetMetadata",
        "additionalProperties": false,
        "type": "object",
        "required": [
          "publication_id",
          "schema_version",
          "api_version",
          "methodology_version",
          "methodology_effective_at",
          "methodology_url",
          "precision_vocabulary_version",
          "price_policy_version",
          "published_at",
          "generated_at",
          "next_refresh_window",
          "counts",
          "degradation_notices"
        ],
        "properties": {
          "publication_id": {
            "$id": "PublicationId",
            "pattern": "^pub_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "schema_version": {
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "type": "string"
          },
          "api_version": {
            "const": "1",
            "type": "string"
          },
          "methodology_version": {
            "minLength": 1,
            "maxLength": 64,
            "type": "string"
          },
          "methodology_effective_at": {
            "format": "date-time",
            "type": "string"
          },
          "methodology_url": {
            "format": "uri",
            "maxLength": 2048,
            "type": "string"
          },
          "precision_vocabulary_version": {
            "minLength": 1,
            "maxLength": 64,
            "type": "string"
          },
          "price_policy_version": {
            "minLength": 1,
            "maxLength": 64,
            "type": "string"
          },
          "published_at": {
            "format": "date-time",
            "type": "string"
          },
          "generated_at": {
            "format": "date-time",
            "type": "string"
          },
          "next_refresh_window": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "starts_at",
              "ends_at"
            ],
            "properties": {
              "starts_at": {
                "format": "date-time",
                "type": "string"
              },
              "ends_at": {
                "format": "date-time",
                "type": "string"
              }
            }
          },
          "counts": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "active_models",
              "active_offerings",
              "active_providers"
            ],
            "properties": {
              "active_models": {
                "minimum": 0,
                "type": "integer"
              },
              "active_offerings": {
                "minimum": 0,
                "type": "integer"
              },
              "active_providers": {
                "minimum": 0,
                "type": "integer"
              }
            }
          },
          "degradation_notices": {
            "type": "array",
            "items": {
              "maxLength": 200,
              "type": "string"
            }
          }
        }
      },
      "ErrorEnvelope": {
        "$id": "ErrorEnvelope",
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "pattern": "^[a-z][a-z0-9_]{0,63}$",
                "type": "string"
              },
              "message": {
                "maxLength": 200,
                "type": "string"
              },
              "details": {
                "maxItems": 10,
                "type": "array",
                "items": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "parameter",
                    "reason"
                  ],
                  "properties": {
                    "parameter": {
                      "maxLength": 64,
                      "type": "string"
                    },
                    "reason": {
                      "maxLength": 200,
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
